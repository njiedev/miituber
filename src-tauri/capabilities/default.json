{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$APPDATA/AFLResHigh_2_3.dat" },
        { "path": "$APPDATA/miituber-tuning-profile.json" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$APPDATA/AFLResHigh_2_3.dat" },
        { "path": "$APPDATA/miituber-tuning-profile.json" }
      ]
    },
    "opener:default",
    "updater:default",
    "process:allow-restart"
  ]
}
